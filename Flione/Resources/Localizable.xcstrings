    },
    "Add .lrc or .txt lyric files next to your music on the server, or search LRCLIB, a free online lyrics database.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在伺服器的音樂檔旁放上 .lrc 或 .txt 歌詞檔，或搜尋 LRCLIB（免費的線上歌詞資料庫）。"
          }
        }
      }
    },
    "Add music to your Jellyfin server and it will appear here.": {
      "localizations": {
