          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener radio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar Rádio"
          }
        }
      }
    },
    "Stop keeping on top": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不再保持在最上層"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最前面に表示しない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 위에 표시 해제"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de mantener encima"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar de manter na frente"
          }
        }
      }
    },
    "Stops playback. Your other music source stays signed in.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止播放。另一個音樂來源的登入會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生を停止します。もう一方の音楽ソースはサインインしたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생을 중단합니다. 다른 음악 소스는 로그인 상태로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene la reproducción. Tu otra fuente de música mantiene la sesión iniciada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe a reprodução. Sua outra fonte de música continua com a sessão iniciada."
          }
        }
      }
    },
    "Strong": {
      "localizations": {
