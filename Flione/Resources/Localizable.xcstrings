    "Bring in the library on your Jellyfin server. Browse it the modern way, and get lost in the album covers.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶進 Jellyfin 伺服器上的音樂庫，用現代化的方式瀏覽，沉浸在音樂封面之中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfinサーバのライブラリを取り込んで、モダンな方法でブラウズし、アルバムカバーの世界に浸りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin 서버의 보관함을 가져옵니다. 현대적인 방식으로 둘러보고 앨범 커버에 빠져 보십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae la biblioteca de tu servidor Jellyfin. Explórala de forma moderna y piérdete entre las portadas de los álbumes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga a biblioteca do seu servidor Jellyfin. Navegue de um jeito moderno e perca-se nas capas dos álbuns."
          }
        }
      }
    },
