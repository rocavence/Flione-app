    "Your session with the music server ended. Sign in again to keep listening.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與音樂伺服器的連線階段已結束。請重新登入以繼續聆聽。"
          }
