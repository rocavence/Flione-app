        }
      }
    },
    "System": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨系統"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        }
      }
    },
    "Tap the heart next to a song and it will show up here.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點歌曲旁的愛心，就會出現在這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲の横のハートをタップすると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래 옆의 하트를 탭하면 여기에 표시됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el corazón junto a una canción y aparecerá aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no coração ao lado de uma música e ela aparecerá aqui."
          }
        }
      }
    },
    "That username and password didn't work. Check them and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者名稱或密碼不正確。請確認後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザ名またはパスワードが正しくありません。確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 이름 또는 암호가 올바르지 않습니다. 확인한 후 다시 시도하십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese nombre de usuario y contraseña no funcionan. Compruébalos y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse nome de usuário e senha não funcionaram. Verifique-os e tente de novo."
          }
        }
      }
    },
    "The blurred cover of the song that's playing, behind the wall.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封面牆後方顯示正在播放歌曲的模糊封面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中の曲のぼかしたカバーをウォールの背後に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커버 월 뒤에 재생 중인 노래의 흐릿한 커버를 표시합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La portada difuminada de la canción en reproducción, detrás del muro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A capa desfocada da música em reprodução, atrás do mural."
          }
        }
      }
    },
    "The cast device couldn't play “%@”. In Settings → Music Source, set a server address it can reach.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "投放裝置無法播放「%@」。請到設定 → 音樂來源，填入它連得到的伺服器位址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャストデバイスで“%@”を再生できませんでした。“設定”→“音楽ソース”で、デバイスからアクセスできるサーバアドレスを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐스트 기기에서 ‘%@’을(를) 재생할 수 없습니다. 설정 → 음악 소스에서 기기가 접근할 수 있는 서버 주소를 설정하십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo de transmisión no ha podido reproducir “%@”. En Ajustes → Fuente de música, indica una dirección de servidor a la que pueda acceder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo de transmissão não conseguiu tocar “%@”. Em Ajustes → Fonte de Música, defina um endereço de servidor que ele consiga acessar."
          }
        }
      }
    },
    "The center cover is always the brightest. Choose how dark the others get as they move away from it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中間的封面永遠最亮，這裡設定離開中間的封面要變多暗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央のカバーが常に最も明るくなります。中央から離れたカバーをどれだけ暗くするかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 커버가 항상 가장 밝습니다. 가운데에서 멀어질수록 다른 커버를 얼마나 어둡게 할지 선택하십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La portada central es siempre la más brillante. Elige cuánto se oscurecen las demás al alejarse de ella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A capa central é sempre a mais clara. Escolha o quanto as outras escurecem à medida que se afastam dela."
          }
        }
      }
    },
    "The colors of every view. The orange that marks what's playing stays the same.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有畫面的顏色。標示正在播放的橘色不會改變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての表示の色。再生中を示すオレンジは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 보기의 색상입니다. 재생 중인 항목을 표시하는 주황색은 그대로 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores de todas las vistas. El naranja que marca lo que se está reproduciendo no cambia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cores de todas as visualizações. O laranja que indica o que está tocando não muda."
          }
        }
      }
    },
    "The free media server Flione was first built for.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費的媒體伺服器，Flione 最早就是為它而做。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Flioneが最初に対応した無料のメディアサーバ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Flione이 처음 만들어진 계기가 된 무료 미디어 서버입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor multimedia gratuito para el que se creó Flione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de mídia gratuito para o qual o Flione foi criado."
          }
        }
      }
    },
    "The glow behind the covers is brightest while you move between albums. Choose how much it dims after you stop.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封面後方的光暈在移動時最亮，這裡設定停下來後要暗多少。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カバーの背後の光は、アルバム間を移動しているときに最も明るくなります。止まった後にどれだけ暗くするかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커버 뒤의 글로우는 앨범 사이를 이동할 때 가장 밝습니다. 멈춘 후 얼마나 어두워질지 선택하십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resplandor detrás de las portadas es más intenso mientras pasas de un álbum a otro. Elige cuánto se atenúa al detenerte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brilho atrás das capas é mais intenso enquanto você passa entre os álbuns. Escolha o quanto ele diminui quando você para."
          }
        }
      }
    },
    "The language of menus, buttons, and messages.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單、按鈕與訊息使用的語言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー、ボタン、メッセージの言語。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴, 버튼 및 메시지의 언어입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de los menús, botones y mensajes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma dos menus, botões e mensagens."
          }
        }
      }
    },
    "The music was back, but the players that worked with it looked plain and dated. So Flione was made.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂都回來了，能用的播放器卻都不太好看，也不夠現代。於是有了 Flione。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽は戻ってきたけれど、対応するプレーヤーはどれも地味で古くさかった。そこでFlioneが生まれました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악은 돌아왔지만 함께 쓸 수 있는 플레이어는 밋밋하고 낡아 보였습니다. 그래서 Flione이 만들어졌습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La música había vuelto, pero los reproductores compatibles se veían simples y anticuados. Así nació Flione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas estavam de volta, mas os players compatíveis pareciam simples e ultrapassados. Então o Flione foi criado."
          }
        }
      }
    },
    "The name": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "命名的故事"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の由来"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름의 유래"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome"
          }
        }
      }
    },
    "The playlist is removed from your music server. The songs stay in your library.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放清單會從音樂伺服器上刪除，歌曲仍留在音樂庫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイリストは音楽サーバから削除されます。曲はライブラリに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이리스트가 음악 서버에서 제거됩니다. 노래는 보관함에 그대로 남아 있습니다."
