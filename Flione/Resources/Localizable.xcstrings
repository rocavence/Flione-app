    "Couldn't add to “%@”. Check your connection to the music server.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法加入「%@」。請檢查與音樂伺服器的連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”に追加できませんでした。音楽サーバとの接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’에 추가할 수 없습니다. 음악 서버 연결을 확인하십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido añadir a “%@”. Comprueba tu conexión con el servidor de música."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível adicionar a “%@”. Verifique sua conexão com o servidor de música."
          }
        }
      }
    },
    "Couldn't connect to %@. Make sure it's turned on and on the same network.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不到 %@。請確認它已開機，而且和這台 Mac 在同一個網路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続できませんでした。電源が入っていて、同じネットワーク上にあることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결할 수 없습니다. 기기가 켜져 있고 같은 네트워크에 있는지 확인하십시오."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar a %@. Asegúrate de que esté encendido y en la misma red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar a %@. Verifique se o dispositivo está ligado e na mesma rede."
          }
        }
      }
    },
