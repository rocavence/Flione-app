    "Auto-scroll is off. The wall moves only when the pointer is away.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動捲動已關閉：游標離開時封面牆才會漂移。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動スクロールはオフです。ポインタが離れているときだけウォールが動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 스크롤이 꺼져 있습니다. 포인터가 벗어났을 때만 커버 월이 움직입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desplazamiento automático está desactivado. El muro solo se mueve cuando el puntero no está encima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rolagem automática está desativada. O mural só se move quando o ponteiro está afastado."
          }
        }
      }
    },
