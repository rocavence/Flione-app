        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1、⌘2、⌘3、または右上隅からいつでも切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘1, ⌘2, ⌘3 또는 오른쪽 상단 모서리에서 언제든지 전환할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar en cualquier momento con ⌘1, ⌘2 y ⌘3, o desde la esquina superior derecha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode alternar a qualquer momento com ⌘1, ⌘2 e ⌘3, ou pelo canto superior direito."
          }
        }
      }
    },
    "Your library is empty.": {
