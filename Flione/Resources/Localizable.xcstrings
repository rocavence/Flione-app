    "A glow in the colors of the album behind album and playlist pages.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專輯頁和播放清單頁的背景，帶上專輯封面的顏色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムとプレイリストのページの背景に、アルバムの色の光を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범 및 플레이리스트 페이지 뒤에 앨범 색상의 빛을 표시합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resplandor con los colores del álbum detrás de las páginas de álbumes y playlists."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um brilho nas cores do álbum atrás das páginas de álbuns e playlists."
          }
        }
      }
    },
    "A native YouTube Music app for macOS. It inspired Flione's sidebar glow, YouTube Music support, lyrics lookup, Dock menu, and more. MIT License.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生的 macOS YouTube Music app。Flione 的側欄光暈、YouTube Music 支援、歌詞查詢、Dock 選單等做法都受它啟發。MIT 授權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS用のネイティブなYouTube Musicアプリ。Flioneのサイドバーの光、YouTube Music対応、歌詞検索、Dockメニューなどはこのアプリから着想を得ています。MITライセンス。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS용 네이티브 YouTube Music 앱. Flione의 사이드바 글로우, YouTube Music 지원, 가사 검색, Dock 메뉴 등은 이 앱에서 영감을 받았습니다. MIT 라이선스."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app nativa de YouTube Music para macOS. Inspiró el resplandor de la barra lateral de Flione, la compatibilidad con YouTube Music, la búsqueda de letras, el menú del Dock y más. Licencia MIT."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app nativo do YouTube Music para macOS. Inspirou o brilho da barra lateral do Flione, o suporte ao YouTube Music, a busca de letras, o menu do Dock e muito mais. Licença MIT."
          }
        }
      }
    },
