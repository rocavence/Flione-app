    "Light or dark. Infinity and Cover Flow are always dark.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淺色或深色。Infinity 和 Cover Flow 固定是深色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトまたはダーク。Infinity と Cover Flow は常にダークです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트 또는 다크. Infinity와 Cover Flow는 항상 다크입니다."
          }
        },
        "es": {
          "stringUnit": {
