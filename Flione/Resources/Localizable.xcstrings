    "Makes titles, menus, and song info a little larger in every view, so long listening sessions are easier on your eyes.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三種模式的標題、選單和歌曲資訊都放大一點，聽久了眼睛比較不累。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての表示でタイトル、メニュー、曲情報を少し大きくして、長時間聴いても目が疲れにくくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 보기에서 제목, 메뉴, 노래 정보를 조금 더 크게 표시하여 오래 들어도 눈이 덜 피로합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agranda un poco los títulos, menús e información de las canciones en todas las vistas para que las sesiones largas cansen menos la vista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa títulos, menus e informações das músicas um pouco maiores em todas as visualizações, para que longas sessões de audição cansem menos os olhos."
          }
        }
      }
    },
