    "This album isn't in your YouTube Music library yet, so it's not on the wall. Add it and Flione takes you there.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張專輯還不在你的 YouTube Music 收藏裡，所以封面牆上沒有它。加入後 Flione 會帶你過去。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムはまだ YouTube Music のライブラリにないため、ウォールに表示されていません。追加すると Flione がそこへ移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앨범은 아직 YouTube Music 보관함에 없어서 월에 표시되지 않습니다. 추가하면 Flione이 해당 앨범으로 이동합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este álbum aún no está en tu biblioteca de YouTube Music, así que no aparece en el muro. Añádelo y Flione te lleva hasta él."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este álbum ainda não está na sua biblioteca do YouTube Music, então não aparece no mural. Adicione e o Flione leva você até ele."
          }
        }
      }
    },
