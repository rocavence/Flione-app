      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動時回到上次使用的畫面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回使用した表示で起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 사용한 보기에서 시작합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza en la última vista que usaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir na última visualização usada."
          }
        }
      }
    },
    "Stop Casting": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止投放"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャストを停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐스트 중단"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener transmisión"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar Transmissão"
          }
        }
      }
    },
    "Stop Radio": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止電台"
          }
        },
        "ja": {
