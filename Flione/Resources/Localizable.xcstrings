    "Suggested by Smart Shuffle": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧隨機播放推薦的歌曲"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートシャッフルのおすすめ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 셔플이 추천한 노래"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerido por Aleatorio inteligente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerida pelo Aleatório Inteligente"
          }
